# Production image. Build stages install every dependency (dev included) to
# test and compile; the runtime stage only carries the production dependencies
# and dist/. The `migrate` target is a one-off job run by
# syner/docker-compose.prod.yml before the service starts.

# Base: Node + pnpm for the build stages
FROM node:24-bookworm-slim AS base
RUN apt-get update \
    && apt-get install -y --no-install-recommends openssl ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && npm i -g pnpm@11.1.3
WORKDIR /app


# Deps: every dependency, needed to build, test and apply the contract
FROM base AS deps
# pnpm-workspace.yaml carries allowBuilds for the native build scripts
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile


# Build: test and compile. The Prisma contract (src/prisma/contract.{json,d.ts})
# is committed, so there is nothing to generate
FROM deps AS build
COPY . .
# The specs import config/envs (validated with Joi at import time) and .env is
# not in the build context, so the template provides placeholder values
RUN cp .env.template .env && pnpm test && rm .env
RUN pnpm build


# Migrate: applies the contract to the database (users collection, validator,
# unique email index). --no-interactive: a destructive change fails the job
# instead of prompting
FROM build AS migrate
CMD ["pnpm", "prisma", "db", "update", "--no-interactive"]


# Prod deps: only `dependencies`
FROM base AS prod-deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --prod --frozen-lockfile


# Runtime (default target)
FROM node:24-bookworm-slim AS prod
WORKDIR /app
ENV NODE_ENV=production
COPY --from=prod-deps --chown=node:node /app/node_modules ./node_modules
# package.json carries "type": "module", so Node loads dist/ as ESM
COPY --from=build --chown=node:node /app/package.json ./
COPY --from=build --chown=node:node /app/dist ./dist
USER node
EXPOSE 3003
CMD ["node", "dist/main.js"]
