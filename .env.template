PORT=3003

# MongoDB 8 running as a replica set (see syner/docker-compose.yml, service auth-db)
DATABASE_URL=mongodb://localhost:27017/authdb?replicaSet=rs0&directConnection=true

JWT_SECRET=change-me
# Optional (default shown)
# JWT_EXPIRES_IN=2h

# Platform superadmin (creates organizations and their members), created on startup if no
# user has SUPERADMIN_EMAIL (it is never overwritten)
SUPERADMIN_NAME=Superadmin
SUPERADMIN_EMAIL=superadmin@syner.com
SUPERADMIN_PASSWORD=change-me
