PORT=3003

# MongoDB 8 running as a replica set (see syner/docker-compose.yml, service auth-db)
DATABASE_URL=mongodb://localhost:27017/authdb?replicaSet=rs0&directConnection=true

JWT_SECRET=change-me
# Optional (default shown)
# JWT_EXPIRES_IN=2h

# Initial owner, created on startup if no user has OWNER_EMAIL (it is never overwritten)
OWNER_NAME=Owner
OWNER_EMAIL=owner@syner.com
OWNER_PASSWORD=change-me
